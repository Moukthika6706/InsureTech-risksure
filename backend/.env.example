# Copy to backend/.env (gitignored) or set in your shell / the Render dashboard.
# Never commit real values.

# Rule assistant (Step 7). Without a key the assistant falls back to the
# pre-written examples in config/rule_examples.yaml.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: database (defaults to SQLite at backend/risksure.db)
# DATABASE_URL=sqlite:///./risksure.db

# CORS: comma-separated frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
